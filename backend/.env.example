# Copy this file to .env (optional in development: the app generates temporary secrets if missing).
PORT=3000
NODE_ENV=development
DB_PATH=./data/padosipro.db

# Required in production. Use long random strings (32+ chars).
JWT_SECRET=change-me-to-a-long-random-string-32-chars-min
JWT_EXPIRES_IN=7d
OTP_HMAC_SECRET=change-me-to-a-different-long-random-string

# Email. Leave SMTP_HOST empty to use Ethereal (a fake inbox; the console prints a preview link).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PadosiPro <no-reply@padosipro.local>

# Dev fallback: also print the OTP in the server console (and do not fail if email cannot be sent).
# NEVER enable in production.
LOG_OTP_TO_CONSOLE=false
